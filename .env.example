# Copy to .env and fill in before the first `docker compose up`.

# The first admin account, created only when the database has none.
# Change the password after signing in is NOT yet supported, so choose it well.
ADMIN_EMAIL=your.name@aau.dk
ADMIN_PASSWORD=
ADMIN_NAME=Course responsible

# Hard ceiling on any single uploaded file, whatever an assignment asks for.
MAX_UPLOAD_MB=250

TIMEZONE=Europe/Copenhagen

# DATA_DIR is deliberately not set here. docker-compose.yml already sets it for
# the container, and a value in this file would also be read by `npm run dev`,
# pointing local development at the container's path.
